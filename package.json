{
    "name": "oblivious-mas-memory",
    "version": "1.0.0",
    "description": "Memory-Type-Aware Oblivious Access Control for Shared Memory in LLM-based Multi-Agent Systems",
    "main": "dist/index.js",
    "engines": {
        "node": ">=20.11.0 <21",
        "npm": ">=10.0.0"
    },
    "scripts": {
        "build": "tsc",
        "build:clean": "rm -rf dist && tsc",
        "build:test": "tsc -p tsconfig.test.json",
        "start": "node dist/memory_service/server.js",
        "dev": "ts-node src/memory_service/server.ts",
        "lint": "eslint src/**/*.ts --max-warnings 0",
        "lint:fix": "eslint src/**/*.ts --fix",
        "format": "prettier --write 'src/**/*.ts' '**/*.md'",
        "format:check": "prettier --check 'src/**/*.ts'",
        "test": "npm run test:unit",
        "test:unit": "TS_NODE_PROJECT=tsconfig.test.json mocha --require ts-node/register 'src/**/*.spec.ts' --timeout 30000",
        "test:circuit": "mocha circuits/tests/unit/*.spec.js --timeout 120000",
        "test:differential": "mocha --require ts-node/register 'circuits/tests/differential/**/*.spec.ts' --timeout 300000",
        "test:pbt": "mocha --require ts-node/register 'circuits/tests/pbt/**/*.spec.ts' --timeout 300000",
        "test:integration": "mocha --require ts-node/register 'circuits/tests/integration/**/*.spec.ts' --timeout 300000",
        "test:ablation": "mocha circuits/tests/ablation/*.spec.js --timeout 120000",
        "test:all": "npm run test:unit && npm run test:circuit && npm run test:differential && npm run test:pbt",
        "circuit:compile": "bash scripts/build/compile_circuits.sh",
        "circuit:setup": "bash scripts/build/trusted_setup_dev.sh",
        "circuit:verify": "npm run circuit:verify:delegate && npm run circuit:verify:write",
        "circuit:verify:delegate": "ts-node scripts/verify/verify_delegate_constraints.ts",
        "circuit:verify:write": "ts-node scripts/verify/verify_write_constraints.ts",
        "setup": "bash setup.sh",
        "setup:data": "ts-node scripts/data/seed_database.ts",
        "setup:pedersen": "ts-node -e \"require('./src/crypto/nothing_up_my_sleeve').ensurePedersenH()\"",
        "experiment:exp1": "ts-node experiments/exp1_circuit_perf/run.ts",
        "experiment:exp2": "ts-node experiments/exp2_correctness/run.ts",
        "experiment:exp3": "ts-node experiments/exp3_e2e/run.ts",
        "experiment:exp4": "ts-node experiments/exp4_defense/run.ts",
        "experiment:exp5": "ts-node experiments/exp5_comparison/run.ts",
        "experiment:exp6": "ts-node experiments/exp6_scalability/run.ts",
        "experiment:exp7": "ts-node experiments/exp7_ablation/run.ts",
        "experiment:exp8": "ts-node experiments/exp8_adaptive/run.ts",
        "experiment:all": "bash scripts/experiments/run_all_experiments.sh",
        "analysis:aggregate": "python3 analysis/aggregate.py",
        "analysis:stats": "python3 analysis/stats.py",
        "analysis:validate": "python3 analysis/validate.py",
        "analysis:verify-claims": "python3 analysis/verify_claims.py",
        "analysis:plots": "bash -c 'for f in analysis/plots/fig*.py; do python3 $f; done'",
        "analysis:tables": "bash -c 'for f in analysis/tables/table*.py; do python3 $f; done'",
        "analysis:all": "npm run analysis:aggregate && npm run analysis:plots && npm run analysis:tables && npm run analysis:verify-claims",
        "docker:build": "docker-compose build",
        "docker:up": "docker-compose up -d memory-service",
        "docker:down": "docker-compose down",
        "docker:logs": "docker-compose logs -f memory-service",
        "docker:experiment": "docker-compose --profile experiment up experiment-runner",
        "reproduce": "bash scripts/experiments/reproduce_paper_results.sh",
        "stage:accept": "bash -c 'for i in 1 2 3 4 5 6 7; do bash scripts/acceptance/stage${i}_acceptance.sh; done'",
        "clean": "rm -rf dist circuits/build logs/*.log",
        "clean:all": "npm run clean && rm -rf node_modules data/*.db artifacts/keys/*.zkey artifacts/keys/*.ptau"
    },
    "dependencies": {
        "@noble/curves": "^1.3.0",
        "@noble/hashes": "^1.3.3",
        "better-sqlite3": "^9.2.2",
        "bloom-filters": "^3.0.1",
        "circomlib": "^2.0.5",
        "circomlibjs": "^0.1.4",
        "cors": "^2.8.5",
        "dotenv": "^17.4.2",
        "express": "^4.18.2",
        "openai": "^4.104.0",
        "secrets.js-grempe": "^2.0.0",
        "seedrandom": "^3.0.5",
        "snarkjs": "^0.7.4",
        "winston": "^3.11.0",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.8",
        "@types/chai": "^4.3.11",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/mocha": "^10.0.6",
        "@types/node": "^20.19.41",
        "@types/seedrandom": "^3.0.8",
        "@types/supertest": "^6.0.2",
        "@typescript-eslint/eslint-plugin": "^6.18.0",
        "@typescript-eslint/parser": "^6.18.0",
        "chai": "^4.3.10",
        "chai-as-promised": "^7.1.1",
        "circom_tester": "^0.0.20",
        "eslint": "^8.56.0",
        "fast-check": "^3.15.0",
        "mocha": "^10.2.0",
        "prettier": "^3.1.1",
        "supertest": "^6.3.3",
        "ts-node": "^10.9.2",
        "typescript": "^5.3.3"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/your-org/oblivious-mas-memory.git"
    },
    "keywords": [
        "zero-knowledge-proofs",
        "multi-agent-systems",
        "access-control",
        "memory-sharing",
        "llm",
        "groth16",
        "circom",
        "privacy"
    ],
    "author": "Your Name <your.email@example.com>",
    "license": "Apache-2.0"
}
