# ================================
# Server Configuration
# ================================
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ================================
# Session Token (MUST CHANGE)
# ================================
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-random-32-bytes-secret-key!

# ================================
# LLM API Keys
# ================================
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini-2024-07-18

# ================================
# Database Paths
# ================================
NULLIFIER_DB_PATH=data/nullifiers.db
MEMORY_DB_PATH=data/memory.db

# ================================
# ZKP Artifacts
# ================================
DELEGATE_WASM=circuits/build/delegate/delegate_js/delegate.wasm
DELEGATE_ZKEY=artifacts/keys/delegate.zkey
DELEGATE_VKEY=artifacts/keys/delegate_vkey.json

WRITE_WASM=circuits/build/write/write_provenance_js/write_provenance.wasm
WRITE_ZKEY=artifacts/keys/write_provenance.zkey
WRITE_VKEY=artifacts/keys/write_provenance_vkey.json

PEDERSEN_H_PATH=artifacts/keys/pedersen_h.json

# ================================
# Experiment Configuration
# ================================
# Platform: edge (MateBook D14) or prod (cloud VM)
PLATFORM=edge

# Task seed
RANDOM_SEED=42

# Task count (500 full, 100 for quick test)
TASK_COUNT=100

# ================================
# Cloud Deployment (optional)
# ================================
AWS_REGION=us-east-1
AWS_INSTANCE_TYPE=c6i.4xlarge

# ================================
# Rate Limiting
# ================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ================================
# Monitoring (optional)
# ================================
ENABLE_METRICS=true
METRICS_PORT=9090