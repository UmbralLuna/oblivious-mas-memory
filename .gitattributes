# Auto detect text files
* text=auto eol=lf

# Text files
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.circom text eol=lf

# Binary files
*.zkey binary
*.ptau binary
*.wasm binary
*.png binary
*.jpg binary
*.pdf binary
*.db binary

# Git LFS (大文件)
artifacts/keys/*.ptau filter=lfs diff=lfs merge=lfs -text
artifacts/keys/*.zkey filter=lfs diff=lfs merge=lfs -text

# Scripts
*.sh text eol=lf
Makefile text eol=lf